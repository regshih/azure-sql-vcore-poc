# Documentation only: the application does NOT automatically load this file or .env.
PORT=8000
HOST=127.0.0.1
APP_ENVIRONMENT=local
REPOSITORY_BACKEND=memory
# Explicit JSON allow-list. Empty disables CORS. Wildcards are rejected.
CORS_ALLOW_ORIGINS=[]
LOG_LEVEL=info

# POC assumptions, not confirmed customer requirements.
# Set SQL_SERVER, SQL_DATABASE and AZURE_CLIENT_ID only in your local environment
# or deployment settings. Never commit populated environment files.
SQL_POOL_SIZE=5
SQL_POOL_MAX_OVERFLOW=0
SQL_POOL_TIMEOUT_SECONDS=2
SQL_LOGIN_TIMEOUT_SECONDS=5
SQL_COMMAND_TIMEOUT_SECONDS=10
REQUEST_TIMEOUT_SECONDS=15
MAX_CONCURRENT_REQUESTS=16
MAX_QUEUED_REQUESTS=32
QUEUE_TIMEOUT_SECONDS=1
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.1
RETRY_MAX_DELAY_SECONDS=2
RETRY_BUDGET_CAPACITY=20
RETRY_BUDGET_REFILL_PER_SECOND=2
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_SECONDS=10
CACHE_BACKEND=disabled
CACHE_TTL_SECONDS=15
CACHE_MAX_ENTRIES=1000
READINESS_MODE=database
ALLOW_UNSAFE_TESTS=false
POC_MODE=true

# INTERNAL_API_TOKEN and APPLICATIONINSIGHTS_CONNECTION_STRING are intentionally
# absent. Deployment supplies the administrative token through encrypted ACA
# secrets; SQL authentication uses managed identity, never a SQL password.
